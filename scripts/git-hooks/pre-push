#!/usr/bin/env python3
"""git pre-push hook — invokes the preflight checks before allowing the push.

This file is invoked by git when `git push` is run. Exit code 0 lets the
push proceed; non-zero aborts before any network activity.

Activation: this hook only runs if scripts/install-hooks.py has been run
once in your clone (it sets git's core.hooksPath to scripts/git-hooks/).
"""

import subprocess
import sys
from pathlib import Path

repo_root = Path(__file__).resolve().parent.parent.parent
preflight = repo_root / "scripts" / "preflight.py"

result = subprocess.run([sys.executable, str(preflight)], cwd=repo_root)
sys.exit(result.returncode)
